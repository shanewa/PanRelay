{
  "manifest_version": 3,
  "name": "度盘接力存",
  "version": "0.5.0",
  "description": "百度网盘助手：点击「保存到网盘」后可分批接力转存（突破500限制）；播放页可选视频倍速；AI 视频笔记可一键下载为 Markdown。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://pan.baidu.com/*",
    "https://yun.baidu.com/*"
  ],
  "action": {
    "default_title": "度盘接力存：点此扫码关注公众号解锁（免费）",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pan.baidu.com/s/*",
        "https://pan.baidu.com/share/init*",
        "https://yun.baidu.com/s/*"
      ],
      "js": ["lib/transfer-core.js", "lib/unlock.js", "content/unlock-guide.js", "content/share-relay.js"],
      "css": ["styles/relay-panel.css", "styles/unlock-guide.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://pan.baidu.com/*", "https://yun.baidu.com/*"],
      "js": ["injected/speed-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://pan.baidu.com/fcb/videoedit*",
        "https://yun.baidu.com/fcb/videoedit*"
      ],
      "js": ["content/note-md.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://pan.baidu.com/*", "https://yun.baidu.com/*"],
      "js": ["lib/media-speed.js", "content/video-speed.js"],
      "css": ["styles/video-speed-hud.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected/page-bridge.js", "assets/wechat-oa-qr.jpg"],
      "matches": ["https://pan.baidu.com/*", "https://yun.baidu.com/*"]
    }
  ]
}
