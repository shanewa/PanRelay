{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File \".cursor/hooks/run-node-hidden.ps1\" -Script \".cursor/hooks/auto-commit.mjs\"",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File \".cursor/hooks/run-node-hidden.ps1\" -Script \"scripts/auto-commit.mjs\" -ExtraArgs --force",
        "timeout": 60
      }
    ]
  }
}
