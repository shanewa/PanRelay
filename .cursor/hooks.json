{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "wscript.exe //nologo \".cursor/hooks/run-node-hidden.vbs\" \".cursor/hooks/auto-commit.mjs\"",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "wscript.exe //nologo \".cursor/hooks/run-node-hidden.vbs\" \"scripts/auto-commit.mjs\" --force",
        "timeout": 60
      }
    ]
  }
}
